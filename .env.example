# Luxion configuration example.
# Copy to `.env` at the project root. Never commit real secrets.

# --- App ---
LUXION_APP__ENVIRONMENT=development
# LUXION_APP__DATA_DIR=D:/LuxionData
# LUXION_APP__LOGS_DIR=D:/LuxionData/logs

# --- Server ---
LUXION_SERVER__HOST=127.0.0.1
LUXION_SERVER__PORT=8756
LUXION_SERVER__RELOAD=false

# --- Database (empty = SQLite at <data_dir>/luxion.db) ---
LUXION_DB__URL=
LUXION_DB__ECHO=false

# --- LLM provider (Phase 1+) ---
# Built-in ids: ollama (default, local) | openai | openai_compatible | openrouter | mock
#
# These are the DEFAULTS. Settings → "Installed provider adapters" lets you
# tap another adapter at runtime; that choice is stored in
# <data_dir>/llm_provider.json (adapter + per-adapter model id) and overrides
# PROVIDER / MODEL / BASE_URL below until you hit "Reset to .env".
LUXION_LLM__PROVIDER=ollama
# Empty = auto-detect the first model the adapter reports
LUXION_LLM__MODEL=
# Endpoint for the LOCAL adapters (ollama / openai_compatible). Cloud adapters
# bring their own: OpenRouter falls back to https://openrouter.ai/api/v1 and
# `openai` to https://api.openai.com/v1 whenever this is the Ollama sentinel.
LUXION_LLM__BASE_URL=http://127.0.0.1:11434
# Read by whichever adapter is active — leave empty for local-only use.
LUXION_LLM__API_KEY=
LUXION_LLM__API_KEY_ENV=
LUXION_LLM__TEMPERATURE=0.7
LUXION_LLM__MAX_TOKENS=2048
LUXION_LLM__REQUEST_TIMEOUT_S=120
# Empty = built-in Luxion system prompt
LUXION_LLM__SYSTEM_PROMPT=
# Per-chunk delay for LUXION_LLM__PROVIDER=mock (seconds)
LUXION_LLM__MOCK_DELAY_S=0

# --- OpenRouter (optional cloud provider) ---
# One key, 500+ models. Base URL defaults to https://openrouter.ai/api/v1 and
# the key env defaults to OPENROUTER_API_KEY, so only these two lines are
# normally needed — plus a model id of your choice:
# LUXION_LLM__PROVIDER=openrouter
# LUXION_LLM__MODEL=deepseek/deepseek-chat
# Key either inline (never commit it) or as an env var name:
# LUXION_LLM__API_KEY=sk-or-v1-...
# LUXION_LLM__API_KEY_ENV=OPENROUTER_API_KEY
# Tip: once the key is in the process environment you can also just tap the
# OpenRouter adapter in Settings — no restart needed.

# --- Context budget (Phase 2+) ---
LUXION_CONTEXT__TOTAL_BUDGET_TOKENS=32000
LUXION_CONTEXT__RESERVE_TOKENS=4000
LUXION_CONTEXT__MAX_TOOL_RESULT_CHARS=6000
LUXION_CONTEXT__MAX_HISTORY_MESSAGES=50
# Newest messages always sent, even when the budget is already full
LUXION_CONTEXT__KEEP_RECENT_MESSAGES=6
# Rolling summary of older messages (false = oldest turns are just dropped)
LUXION_CONTEXT__SUMMARY_ENABLED=true
LUXION_CONTEXT__SUMMARY_MAX_TOKENS=1200
# Summarize once this many uncovered messages have piled up
LUXION_CONTEXT__SUMMARY_MIN_MESSAGES=4

# --- Security ---
# Autonomy: 0 AnswerOnly .. 5 AdvancedAutonomy (never overrides permissions)
LUXION_SECURITY__AUTONOMY_LEVEL=3
# Directories the file tools may read/write (PRD §42). Semicolon-separated.
# Empty or unset falls back to the project root — never the whole drive.
# LUXION_SECURITY__ALLOWED_WORKSPACES=D:/Notes;D:/Projects
LUXION_SECURITY__TERMINAL_TIMEOUT_S=60

# --- Tools (Phase 3) ---
# Master switch: false means the model is never offered any tools
LUXION_TOOLS__ENABLED=true
# Hard cap on agent rounds per user turn (no infinite loops)
LUXION_TOOLS__MAX_ITERATIONS=6
# Per-tool wall clock limit in seconds
LUXION_TOOLS__TIMEOUT_S=30
# How many tools may be exposed to the model for one request
LUXION_TOOLS__MAX_EXPOSED=16
# Retained audit-log entries in <data_dir>/tool_log.jsonl
LUXION_TOOLS__LOG_LIMIT=500
# How long the user has to answer a confirmation prompt (seconds)
LUXION_TOOLS__CONFIRM_TIMEOUT_S=180
# Extra directories scanned for dynamically loaded *.py tool plugins
# (each exposes `TOOLS = [...]` or a `register(registry)` function)
# LUXION_TOOLS__PLUGIN_DIRS=D:/LuxionPlugins

# --- Voice (Phase 4) ---
# Master switch for the microphone session (PRD §26)
LUXION_VOICE__MASTER=true
# Speech to text (PRD §5.5): faster-whisper. The model is downloaded on first
# use and then cached under ~/.cache/huggingface.
LUXION_VOICE__STT_PROVIDER=whisper
LUXION_VOICE__STT_MODEL=base.en
# auto | cpu | cuda
LUXION_VOICE__STT_DEVICE=auto
LUXION_VOICE__STT_COMPUTE_TYPE=int8
# Empty = auto-detect (".en" models are English-only regardless)
LUXION_VOICE__STT_LANGUAGE=
# Text to speech (PRD §5.6): windows = offline SAPI5 voices
LUXION_VOICE__TTS_PROVIDER=windows
LUXION_VOICE__TTS_ENABLED=true
# SAPI5 rate offset (words/minute around the voice's natural rate) and volume
LUXION_VOICE__TTS_RATE=0
LUXION_VOICE__TTS_VOLUME=100
# Wake word (PRD §26). Empty phrase = wake word effectively unusable.
LUXION_VOICE__WAKE_ENABLED=true
LUXION_VOICE__WAKE_PHRASE=hey luxion
# How long a bare "Hey Luxion" stays armed waiting for the command
LUXION_VOICE__WAKE_ARM_S=20
# Input device: empty = system default, otherwise a PortAudio index or a
# case-insensitive fragment of the device name (indices drift across reboots).
LUXION_VOICE__MIC_DEVICE=
# Energy voice-activity gate and segmentation timings (seconds)
LUXION_VOICE__VAD_THRESHOLD=0.01
LUXION_VOICE__MIN_SPEECH_S=0.2
LUXION_VOICE__SILENCE_S=0.9
LUXION_VOICE__MAX_UTTERANCE_S=30
# Cut TTS playback short when the user talks over it (needs a quiet room or
# headphones - speaker echo can trip it)
LUXION_VOICE__BARGE_IN=true
# Push-to-talk budget in the chat composer
LUXION_VOICE__PTT_TIMEOUT_S=15

# --- Logging ---
LUXION_LOGGING__LEVEL=INFO
LUXION_LOGGING__JSON_LOGS=true
LUXION_LOGGING__CONSOLE=true
